# Copy to .env (repo root). All optional.
PORT=2567
# Most rooms at once (phase 19); beyond it players see "Server full, try again soon"
MAX_ROOMS=20
# 1 in dev, 2 in production if unset
MIN_PLAYERS=2
# e.g. MIN_PLAYERS=4 for a 4-bot soak (the round waits for everyone)
# Optional testing override of the level pool (default: every level with "pool": true, voted on in the lobby).
# One level id (always that level) or a comma list (the vote picks among them).
# LEVEL=race-01,arena-01,arena-02
# e.g. LEVEL=test-stomp                  (a single beam to practise jump-over, stomp and clash; not in any rotation)
# Movement timing preset (phase 17): classic (default) or snappy (quicker rolls, turns, flips and jumps)
# TIMING=snappy
# PvP push: on (default) or off (MVP rules: no pushing, deaths keep keys)
PUSH=on
# Simulated round-trip latency in ms (dev only), 0 = off
LATENCY_MS=0
# Fly.io deploy token (phase 19), used by `npm run fly` / `npm run deploy`. Never commit it.
# FLY_API_TOKEN=
