{
  "name": "kulaworld",
  "private": true,
  "type": "module",
  "workspaces": ["packages/shared", "packages/server", "packages/client", "tools/bots"],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w packages/server\" \"npm run dev -w packages/client\"",
    "build": "npm run typecheck && npm run build -w packages/client",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bots": "tsx tools/bots/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
